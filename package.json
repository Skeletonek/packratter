{
  "name": "packratter",
  "version": "0.6.0",
  "description": "Host-only package repository manager for deb, rpm, pacman and flatpak.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:server": "tsx watch --env-file=.env src/index.ts",
    "dev:ui": "cd ui && vite dev",
    "dev": "concurrently --names=server,ui --kill-others \"pnpm dev:server\" \"pnpm dev:ui\"",
    "build:server": "tsc && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/migrations",
    "build:ui": "cd ui && svelte-kit sync && vite build",
    "build": "pnpm build:server && pnpm build:ui",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:full": "RUN_FULL_TESTS=1 vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "argon2": "^0.45.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "fastify": "^5.12.5",
    "p-queue": "^9.3.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "files": [
    "dist"
  ]
}
