# syntax=docker/dockerfile:1
ARG NODE_VERSION=24.21.0

# Dev image: same base as production — Fedora 44 + Node from the official tarball
# plus the full format toolchain. Application code is bind-mounted over /app, so
# this image only needs the runtime toolchain and pnpm.
FROM registry.fedoraproject.org/fedora:44
ARG NODE_VERSION
RUN dnf -y install createrepo_c dpkg-devel ostree flatpak gnupg2 zstd tar xz \
      bsdtar pacman apt-utils curl findutils \
 && dnf clean all

RUN curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz \
  | tar -xJ -C /usr/local --strip-components=1 --exclude='share/*'

# Pin corepack's pnpm cache to a fixed path inside the image so that overriding
# $HOME at runtime (to match host pnpm settings, see docker-compose.dev.yml)
# still finds the prepared pnpm offline.
ENV COREPACK_HOME=/opt/corepack

RUN corepack enable \
 && corepack prepare pnpm@11.28.5 --activate

WORKDIR /app
EXPOSE 5000 5173
