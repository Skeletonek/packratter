NODE_ENV=development
DATA_DIR=./data
GPG_ROOT=./data/keys/gnupg
LOG_LEVEL=info
PORT=5000

# Optional: password for the first-boot admin account. When unset, a strong
# password is generated and printed once on first startup.
ADMIN_USER=admin
ADMIN_PASS=change-me

# Public URL used in setup snippets shown to repo clients
BASE_URL=http://localhost:5000

# Set 1 when behind a TLS-terminating reverse proxy, so rate limiting keys on
# the real client IP instead of the proxy's address
TRUST_PROXY=0

# Login session lifetime, in minutes (without "remember this device")
SESSION_TTL_MIN=1440
# Login session lifetime with "remember this device" checked, in days
SESSION_REMEMBER_DAYS=7

# OIDC single sign-on; all three set adds a "Sign in with SSO" button.
# On first boot these seed the editable configuration in Settings →
# Authentication; afterwards the database row wins and .env changes are inert.
#SSO_ISSUER=https://auth.example.com/application/o/packratter/
#SSO_CLIENT_ID=packratter
#SSO_CLIENT_SECRET=change-me
# Space-separated scopes to request; extend when the admin claim lives in a
# groups/roles scope, e.g. "openid profile email groups"
#SSO_SCOPES=openid profile email
# userinfo claim (dotted path ok) whose value grants admin on SSO sign-in;
# needs SSO_ADMIN_VALUE
#SSO_ADMIN_CLAIM=realm_access.roles
#SSO_ADMIN_VALUE=packratter-admin
# Set 0 to deny SSO sign-in for identities without an existing account
#SSO_AUTO_CREATE=1

# Turn an ecosystem off regardless of installed tooling ('1' disables it);
# disabled types answer 409 TYPE_DISABLED and produce no UI warning banner
#DISABLE_PACMAN=1
#DISABLE_DEB=1
#DISABLE_RPM=1
#DISABLE_FLATPAK=1
