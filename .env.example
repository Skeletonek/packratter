NODE_ENV=development
DATA_DIR=./data
PORT=5000
ADMIN_USER=admin
# Optional: password for the first-boot admin account. When unset, a strong
# password is generated and printed once on first startup.
ADMIN_PASS=change-me
# Public URL used in setup snippets shown to repo clients
BASE_URL=http://localhost:5000
# Login session lifetime, in minutes (without "remember this device")
SESSION_TTL_MIN=1440
# Login session lifetime with "remember this device" checked, in days
SESSION_REMEMBER_DAYS=7
# Turn an ecosystem off regardless of installed tooling ('1' disables it);
# disabled types answer 409 TYPE_DISABLED and produce no UI warning banner
#DISABLE_PACMAN=1
#DISABLE_DEB=1
#DISABLE_RPM=1
#DISABLE_FLATPAK=1
GPG_ROOT=./data/keys/gnupg
LOG_LEVEL=info
